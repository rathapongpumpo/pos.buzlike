# Hostinger MySQL/MariaDB. Add through hPanel Environment variables.
DATABASE_PROVIDER=mysql
DATABASE_URL=mysql://HOSTINGER_DB_USER:CHANGE_ME@127.0.0.1:3306/HOSTINGER_DATABASE?connection_limit=5&connect_timeout=10&pool_timeout=20
TOKIO_WORKER_THREADS=2
AUTH_URL=https://pos.buzlike.com
NEXT_PUBLIC_APP_URL=https://pos.buzlike.com
AUTH_TRUST_HOST=true
AUTH_SECRET=GENERATE_A_NEW_RANDOM_SECRET_AT_LEAST_32_BYTES
OPERATIONS_TOKEN=GENERATE_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_BYTES
SEED_DEMO=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BUZLIKE POS <support@buzlike.com>
OUTBOUND_EMAIL_ENABLED=false
RESTORE_DRILL=false
LEGAL_CONTACT_APPROVED=false
