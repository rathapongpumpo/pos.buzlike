generator client {
  provider = "prisma-client-js"
}

// Operational metadata is separate from customer/financial records.
model WorkerHeartbeat {
  name String @id
  lastAttemptAt DateTime
  lastSuccessAt DateTime?
  lastFailureAt DateTime?
  consecutiveFailures Int @default(0)
  state String
}

// A restored copy stays quarantined even if SMTP environment settings are copied.
model OperationalControl {
  id String @id @default("platform")
  outboundQuarantinedAt DateTime?
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. SAAS PLATFORM, TENANT & BILLING MODELS
// ==========================================

enum SystemRole {
  USER
  SUPER_ADMIN
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  LIFETIME_ACTIVE
  PAST_DUE
  READ_ONLY
  SUSPENDED
}

enum PlanCode {
  FREE_TRIAL
  STARTER_MONTHLY
  STARTER_YEARLY
  PRO_MONTHLY
  PRO_YEARLY
  LIFETIME_BUYOUT
}

enum BusinessType {
  CAFE_BEVERAGE
  RESTAURANT
  RETAIL_SHOP
}

model User {
  pendingPilotInvitationId String?
  pendingPilotInvitationVersion Int?
  pendingPilotInvitation PilotInvitation? @relation("PendingPilot", fields: [pendingPilotInvitationId], references: [id], onDelete: SetNull)
  issuedPilotInvitations PilotInvitation[] @relation("PilotIssuer")
  claimedPilotInvitations PilotInvitation[] @relation("PilotClaimant")
  pilotEnrollments PilotEnrollment[]
  pilotWaitlist PilotWaitlistEntry?
  pilotFeedback PilotFeedback[]
  pilotFeedbackHistory PilotFeedbackHistory[]
  pilotAudit PilotAuditEvent[]
  releaseUpdates ReleaseSettings[]
  id            String       @id @default(cuid())
  email         String       @unique
  passwordHash  String?
  emailVerifiedAt DateTime?
  emailVerificationRequired Boolean @default(false)
  sessionVersion Int @default(0)
  selectedPlan PlanCode?
  accountTokens AccountToken[]
  googleIdentity GoogleIdentity?
  googleLinkChallenges GoogleLinkChallenge[]
  accountEmails EmailOutbox[]
  onboardingDraft OnboardingDraft?
  onboardingRequests OnboardingRequest[]
  fullName      String
  phone         String?
  systemRole    SystemRole   @default(USER)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  memberships   StaffMember[]
  ownedTenants  Tenant[]     @relation("TenantOwner")
}

// Only stable Google identity is retained; OAuth access/refresh tokens are not stored.
model GoogleIdentity {
  id String @id @default(cuid())
  subject String @unique
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// Password re-authentication grants a short, single-use same-email link attempt.
model GoogleLinkChallenge {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionVersion Int
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}

model Tenant {
  pilotEnrollments PilotEnrollment[]
  pilotFeedback PilotFeedback[]
  id                  String             @id @default(cuid())
  name                String
  slug                String             @unique // ใช้ใน URL เช่น pos.buzlike.com/my-cafe
  businessType        BusinessType       @default(CAFE_BEVERAGE)
  ownerId             String
  owner               User               @relation("TenantOwner", fields: [ownerId], references: [id])
  
  // Subscription & Entitlements
  planCode            PlanCode           @default(FREE_TRIAL)
  subscriptionStatus  SubscriptionStatus @default(TRIALING)
  trialEndsAt         DateTime
  currentPeriodEndsAt DateTime?
  isLifetime          Boolean            @default(false)
  stripeCustomerId    String?            @unique
  stripeSubId         String?            @unique
  stripeSubscriptionStatus String?
  cancelAtPeriodEnd Boolean @default(false)
  billingSyncedAt DateTime?
  billingLock BillingLock?
  
  // Quota Limits (Override ได้รายร้านจากหน้า Super Admin)
  maxBranches         Int                @default(1)
  maxTerminals        Int                @default(1)
  maxProducts         Int                @default(50)
  maxStaff            Int                @default(3)
  enableKds           Boolean            @default(true)
  enableQrOrder       Boolean            @default(true)
  enableRecipeBom     Boolean            @default(true)
  enableExport        Boolean            @default(false)

  // Tax & Billing Info ของร้านค้า (สำหรับออกใบกำกับภาษีค่าสมาชิก)
  companyName         String?
  taxId               String?
  billingAddress      String?
  
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  branches            StoreBranch[]
  staffMembers        StaffMember[]
  categories          Category[]
  products            Product[]
  modifierGroups      ModifierGroup[]
  ingredients         Ingredient[]
  subscriptions       SaasPayment[]
  auditLogs           AuditLog[]
  onboardingRequests OnboardingRequest[]
  @@unique([id, ownerId])
}

model SaasPayment {
  providerCheckedAt DateTime?
  checkoutKey String? @unique
  checkoutHash String?
  checkoutUrl String?
  checkoutExpiresAt DateTime?
  stripeInvoiceId String? @unique
  stripePaymentIntentId String? @unique
  stripeSubscriptionId String?
  periodStart DateTime?
  periodEnd DateTime?
  receipt Json?
  refundedAmount Decimal @default(0) @db.Decimal(10, 2)
  providerRef String? @unique
  couponCode String?
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceNumber       String   @unique // เช่น INV-202611-0001
  planCode            PlanCode
  amount              Decimal  @db.Decimal(10, 2)
  vatAmount           Decimal  @db.Decimal(10, 2)
  totalAmount         Decimal  @db.Decimal(10, 2)
  paymentMethod       String   // STRIPE_CARD, STRIPE_PROMPTPAY, BANK_SLIP
  status              String   // PENDING, PAID, FAILED, REFUNDED
  slipImageUrl        String?
  paidAt              DateTime?
  createdAt           DateTime @default(now())
  @@index([tenantId, status, createdAt])
  @@index([status, providerCheckedAt])
}

// Cross-process lease: provider reads/writes are kept outside retryable DB transactions.
model BillingLock {
  tenantId String @id
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  token String
  expiresAt DateTime
}

// ==========================================
// 2. STORE BRANCH, STAFF & SHIFT MANAGEMENT
// ==========================================

enum StaffRole {
  OWNER
  MANAGER
  CASHIER
  KITCHEN
  WAITER
}

// Pilot grants are separate from financial subscriptions and never create paid invoices.
model ReleaseSettings {
  id String @id @default("platform")
  releaseMode String @default("LEGACY")
  checkoutMode String @default("PUBLIC")
  version Int @default(0)
  updatedById String?
  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: Restrict)
  updatedAt DateTime @updatedAt
}

model PilotCampaign {
  id String @id @default(cuid())
  slug String @unique
  status String @default("DRAFT")
  capacity Int @default(5)
  durationDays Int @default(30)
  reservationHours Int @default(72)
  entitlementProfile String @default("PILOT_PRO_V1")
  entitlementsSnapshot Json
  version Int @default(0)
  createdAt DateTime @default(now())
  invitations PilotInvitation[]
  enrollments PilotEnrollment[]
  auditEvents PilotAuditEvent[]
}

model PilotInvitation {
  id String @id @default(cuid())
  campaignId String
  campaign PilotCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  normalizedEmail String
  tokenHash String @unique
  tokenVersion Int @default(1)
  expiresAt DateTime
  revokedAt DateTime?
  claimedByUserId String?
  claimant User? @relation("PilotClaimant", fields: [claimedByUserId], references: [id], onDelete: Restrict)
  claimedAt DateTime?
  createdByUserId String
  issuer User @relation("PilotIssuer", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  pendingUsers User[] @relation("PendingPilot")
  enrollment PilotEnrollment?
  @@unique([campaignId, id])
  @@index([campaignId, normalizedEmail])
}

model PilotEnrollment {
  id String @id @default(cuid())
  campaignId String
  campaign PilotCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  invitationId String @unique
  invitation PilotInvitation @relation(fields: [campaignId, invitationId], references: [campaignId, id], onDelete: Restrict)
  tenantId String?
  tenant Tenant? @relation(fields: [tenantId, ownerId], references: [id, ownerId], onDelete: Restrict)
  status String @default("RESERVED")
  reservedUntil DateTime?
  activatedAt DateTime?
  endsAt DateTime?
  version Int @default(1)
  entitlementsSnapshot Json
  createdAt DateTime @default(now())
  feedback PilotFeedback[]
  notifications EmailOutbox[]
  auditEvents PilotAuditEvent[]
  @@unique([campaignId, ownerId])
  @@unique([campaignId, invitationId])
  @@unique([campaignId, tenantId])
  @@unique([id, tenantId])
  @@index([campaignId, status, reservedUntil])
  @@index([status, endsAt])
  @@index([tenantId, activatedAt])
}

model PilotWaitlistEntry {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  status String @default("WAITING")
  notifyConsentAt DateTime?
  withdrawnAt DateTime?
  notifiedAt DateTime?
  createdAt DateTime @default(now())
}

model PilotFeedback {
  id String @id @default(cuid())
  enrollmentId String
  tenantId String
  enrollment PilotEnrollment @relation(fields: [enrollmentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  branchId String
  branch StoreBranch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  submittedByUserId String
  author User @relation(fields: [submittedByUserId], references: [id], onDelete: Restrict)
  submittedByStaffId String
  staff StaffMember @relation(fields: [tenantId, submittedByStaffId], references: [tenantId, id], onDelete: Restrict)
  requestKey String
  category String
  message String
  optionalRating Int?
  pageKey String
  deviceClass String
  severity String?
  status String @default("NEW")
  createdAt DateTime @default(now())
  history PilotFeedbackHistory[]
  @@unique([tenantId, submittedByStaffId, requestKey])
  @@index([tenantId, createdAt])
  @@index([status, createdAt])
}

model PilotFeedbackHistory {
  id String @id @default(cuid())
  feedbackId String
  feedback PilotFeedback @relation(fields: [feedbackId], references: [id], onDelete: Restrict)
  actorUserId String
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  fromStatus String
  toStatus String
  note String
  createdAt DateTime @default(now())
}

model PilotAuditEvent {
  id String @id @default(cuid())
  campaignId String
  campaign PilotCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  enrollmentId String?
  enrollment PilotEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  actorUserId String?
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  action String
  reason String?
  before Json?
  after Json?
  createdAt DateTime @default(now())
  @@index([campaignId, createdAt])
  @@index([enrollmentId, createdAt])
}

model StoreBranch {
  pilotFeedback PilotFeedback[]
  id                  String         @id @default(cuid())
  tenantId            String
  tenant              Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String         // เช่น "สาขาสยาม (สำนักงานใหญ่)"
  address             String?
  phone               String?
  taxId               String?        // เลขผู้เสียภาษีสำหรับพิมพ์หัวใบเสร็จ
  receiptHeader       String?        // ข้อความต้อนรับบนหัวใบเสร็จ
  receiptFooter       String?        @default("ขอบคุณที่ใช้บริการ / Thank you!")
  promptPayId         String?        // เบอร์โทร 10 หลัก หรือเลขผู้เสียภาษี 13 หลัก สำหรับสร้าง QR รับเงินหน้าร้าน
  promptPayName       String?        // ชื่อบัญชีพร้อมเพย์ที่แสดงให้ลูกค้าตรวจ
  vatRate             Decimal        @default(7.00) @db.Decimal(5, 2)
  vatInclusive        Boolean        @default(true) // true = ราคาสินค้ารวม VAT แล้ว, false = บวก VAT เพิ่มท้ายบิล
  serviceChargeRate   Decimal        @default(0.00) @db.Decimal(5, 2)
  isActive            Boolean        @default(true)
  
  diningZones         DiningZone[]
  shifts              CashierShift[]
  orders              Order[]
  stockLevels         BranchIngredientStock[]
  stockMovements      StockMovement[]
  productStocks       BranchProduct[]
  staffAccess         StaffBranchAccess[]

  @@index([tenantId])
  @@unique([tenantId, id])
}

model StaffMember {
  pilotFeedback PilotFeedback[]
  id                  String      @id @default(cuid())
  tenantId            String
  tenant              Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId              String?
  user                User?       @relation(fields: [userId], references: [id])
  displayName         String
  role                StaffRole   @default(CASHIER)
  pinCodeHash         String      // รหัส PIN 4-6 หลักสำหรับกดสลับพนักงานหน้าเครื่อง POS
  isActive            Boolean     @default(true)
  createdAt           DateTime    @default(now())
  shifts              CashierShift[]
  ordersCreated       Order[]
  branchAccess        StaffBranchAccess[]
  invitations         StaffInvitation[]

  @@index([tenantId])
  @@unique([tenantId, id])
  @@unique([tenantId, userId])
}

model CashierShift {
  id                  String      @id @default(cuid())
  tenantId            String
  branchId            String
  branch              StoreBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staffId             String
  staff               StaffMember @relation(fields: [staffId], references: [id])
  openedAt            DateTime    @default(now())
  closedAt            DateTime?
  startingCash        Decimal     @db.Decimal(10, 2) // เงินทอนตั้งต้นในลิ้นชัก
  expectedCash        Decimal?    @db.Decimal(10, 2) // เงินสดที่ระบบคำนวณได้ (เงินตั้งต้น + ยอดขายเงินสด - เงินสดนำออก)
  actualCash          Decimal?    @db.Decimal(10, 2) // เงินสดที่นับได้จริงตอนปิดกะ
  cashDifference      Decimal?    @db.Decimal(10, 2) // ส่วนต่าง (ขาด/เกิน)
  closingNote         String?
  status              String      @default("OPEN")   // OPEN, CLOSED
  orders              Order[]

  @@index([tenantId, branchId])
}

// ==========================================
// 3. CATALOG, MODIFIERS & RECIPE BOM (INVENTORY)
// ==========================================

model Category {
  id                  String    @id @default(cuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  sortOrder           Int       @default(0)
  kitchenStation      String    @default("MAIN") // MAIN, BAR, BAKERY (ใช้แยกจอ KDS)
  isActive            Boolean   @default(true)
  products            Product[]

  @@index([tenantId])
}

model Product {
  id                  String                  @id @default(cuid())
  tenantId            String
  tenant              Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId          String
  category            Category                @relation(fields: [categoryId], references: [id])
  sku                 String
  barcode             String?
  name                String
  description         String?
  imageUrl            String?
  price               Decimal                 @db.Decimal(10, 2)
  costPrice           Decimal                 @default(0.00) @db.Decimal(10, 2)
  trackStockType      String                  @default("RECIPE") // NONE, DIRECT_UNIT, RECIPE
  directStockQty      Int                     @default(0)        // ใช้กรณีขายสินค้าสำเร็จรูปเป็นชิ้น
  lowStockThreshold   Int                     @default(5)
  isAvailable         Boolean                 @default(true)
  sortOrder           Int                     @default(0)
  modifierGroups      ProductModifierGroup[]
  recipeItems         RecipeBomItem[]
  orderItems          OrderItem[]
  branchStocks        BranchProduct[]

  @@unique([tenantId, sku])
  @@unique([tenantId, id])
  @@index([tenantId, categoryId])
}

model StaffBranchAccess {
  tenantId String
  staffId String
  branchId String
  staff StaffMember @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Cascade)
  branch StoreBranch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  @@id([staffId, branchId])
  @@index([tenantId, branchId])
}

model BranchProduct {
  tenantId String
  branchId String
  productId String
  price Decimal @db.Decimal(10, 2)
  quantity Int @default(0)
  isAvailable Boolean @default(true)
  version Int @default(0)
  branch StoreBranch @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  product Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)
  movements ProductStockMovement[]
  @@id([branchId, productId])
  @@unique([tenantId, branchId, productId])
}

model ProductStockMovement {
  id String @id @default(cuid())
  tenantId String
  branchId String
  productId String
  orderId String?
  kind String
  quantityChange Int
  balanceAfter Int
  reason String?
  createdAt DateTime @default(now())
  stock BranchProduct @relation(fields: [tenantId, branchId, productId], references: [tenantId, branchId, productId], onDelete: Cascade)
  order Order? @relation(fields: [tenantId, branchId, orderId], references: [tenantId, branchId, id], onDelete: Cascade)
  @@unique([tenantId, branchId, orderId, productId, kind])
  @@index([tenantId, branchId, createdAt])
}

model ModifierGroup {
  id                  String                 @id @default(cuid())
  tenantId            String
  tenant              Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String                 // เช่น "ระดับความหวาน", "เลือกชนิดนม", "เพิ่มท็อปปิ้ง"
  isRequired          Boolean                @default(false)
  minSelect           Int                    @default(0)
  maxSelect           Int                    @default(1)
  options             ModifierOption[]
  products            ProductModifierGroup[]

  @@index([tenantId])
}

model ModifierOption {
  tenantId String
  @@index([tenantId])
  id                  String        @id @default(cuid())
  modifierGroupId     String
  modifierGroup       ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  name                String        // เช่น "หวานน้อย (50%)", "นมโอ๊ต (+20฿)", "เพิ่มช็อตกาแฟ (+15฿)"
  priceDelta          Decimal       @default(0.00) @db.Decimal(10, 2)
  isDefault           Boolean       @default(false)
  sortOrder           Int           @default(0)
}

model ProductModifierGroup {
  tenantId String
  @@index([tenantId])
  productId           String
  product             Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierGroupId     String
  modifierGroup       ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  sortOrder           Int           @default(0)

  @@id([productId, modifierGroupId])
}

model Ingredient {
  id                  String                  @id @default(cuid())
  tenantId            String
  tenant              Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku                 String
  name                String                  // เช่น "เมล็ดกาแฟคั่วกลาง", "นมสดพาสเจอร์ไรส์", "แก้วพลาสติก 16 oz"
  unit                String                  // เช่น "g", "ml", "ชิ้น"
  costPerUnit         Decimal                 @default(0.0000) @db.Decimal(10, 4)
  lowStockThreshold   Decimal                 @default(500) @db.Decimal(10, 2)
  recipeItems         RecipeBomItem[]
  branchStocks        BranchIngredientStock[]
  movements           StockMovement[]

  @@index([tenantId])
}

model RecipeBomItem {
  tenantId String
  @@index([tenantId])
  id                  String     @id @default(cuid())
  productId           String
  product             Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredientId        String
  ingredient          Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantityUsed        Decimal    @db.Decimal(10, 2) // เช่น ใช้เมล็ดกาแฟ 18 g ต่อ 1 แก้ว

  @@unique([productId, ingredientId])
}

model BranchIngredientStock {
  tenantId String
  @@index([tenantId])
  id                  String      @id @default(cuid())
  branchId            String
  branch              StoreBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ingredientId        String
  ingredient          Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  currentQty          Decimal     @default(0.00) @db.Decimal(12, 2)
  updatedAt           DateTime    @updatedAt

  @@unique([branchId, ingredientId])
}

model StockMovement {
  id                  String      @id @default(cuid())
  tenantId            String
  branchId            String
  branch              StoreBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ingredientId        String
  ingredient          Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  type                String      // INBOUND (รับเข้า), SALE_DEDUCTION (ตัดตามบิลขาย), WASTE (ของเสีย), ADJUST (ปรับยอด)
  quantityChange      Decimal     @db.Decimal(12, 2) // ค่าบวกหรือลบ
  balanceAfter        Decimal     @db.Decimal(12, 2)
  referenceOrderId    String?
  note                String?
  createdAt           DateTime    @default(now())

  @@index([tenantId, branchId, createdAt])
}

// ==========================================
// 4. TABLES, ORDERS, KDS & PAYMENTS
// ==========================================

model DiningZone {
  tenantId String
  @@index([tenantId])
  id                  String        @id @default(cuid())
  branchId            String
  branch              StoreBranch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name                String        // เช่น "โซนห้องแอร์ (Indoor)", "โซนสวน (Outdoor)"
  sortOrder           Int           @default(0)
  tables              DiningTable[]
}

model DiningTable {
  tenantId String
  @@index([tenantId])
  id                  String      @id @default(cuid())
  zoneId              String
  zone                DiningZone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  name                String      // เช่น "T-01", "T-02"
  seats               Int         @default(4)
  status              String      @default("AVAILABLE") // AVAILABLE, OCCUPIED, BILL_REQUESTED
  activeQrToken       String?     @unique               // Token แบบสุ่มที่สร้างใหม่ทุกครั้งที่เปิดโต๊ะ
  currentOrderId      String?
  orders              Order[]
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  OPEN
  PAID
  VOIDED
  REFUNDED
}

enum KitchenStatus {
  QUEUED
  PREPARING
  READY
  SERVED
}

model Order {
  clientOrderId String
  requestHash String
  @@unique([tenantId, clientOrderId])
  id                  String         @id @default(cuid())
  tenantId            String
  branchId            String
  branch              StoreBranch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  shiftId             String?
  shift               CashierShift?  @relation(fields: [shiftId], references: [id])
  staffId             String?
  staff               StaffMember?   @relation(fields: [staffId], references: [id])
  tableId             String?
  table               DiningTable?   @relation(fields: [tableId], references: [id])
  
  orderNumber         String         // เช่น "ORD-20261105-0042"
  queueNumber         Int            // เลขคิวรายวัน เช่น 42
  orderType           OrderType      @default(DINE_IN)
  status              OrderStatus    @default(OPEN)
  kitchenStatus       KitchenStatus  @default(QUEUED)
  
  subtotal            Decimal        @db.Decimal(10, 2)
  discountAmount      Decimal        @default(0.00) @db.Decimal(10, 2)
  discountReason      String?
  serviceChargeAmount Decimal        @default(0.00) @db.Decimal(10, 2)
  vatAmount           Decimal        @default(0.00) @db.Decimal(10, 2)
  grandTotal          Decimal        @db.Decimal(10, 2)
  
  customerNote        String?
  voidReason          String?
  createdAt           DateTime       @default(now())
  paidAt              DateTime?
  
  items               OrderItem[]
  payments            OrderPayment[]
  productMovements    ProductStockMovement[]

  @@unique([tenantId, orderNumber])
  @@unique([tenantId, branchId, id])
  @@index([tenantId, branchId, createdAt])
}

model OrderItem {
  tenantId String
  @@index([tenantId])
  id                  String              @id @default(cuid())
  orderId             String
  order               Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  product             Product             @relation(fields: [productId], references: [id])
  productNameSnapshot String              // เก็บชื่อสินค้า ณ เวลาขาย
  unitPriceSnapshot   Decimal             @db.Decimal(10, 2)
  quantity            Int
  modifiersTotal      Decimal             @default(0.00) @db.Decimal(10, 2)
  lineTotal           Decimal             @db.Decimal(10, 2)
  kitchenStation      String              @default("MAIN")
  kitchenStatus       KitchenStatus       @default(QUEUED)
  note                String?
  modifiers           OrderItemModifier[]
}

model OrderItemModifier {
  tenantId String
  @@index([tenantId])
  id                  String    @id @default(cuid())
  orderItemId         String
  orderItem           OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierName        String
  optionName          String
  priceDelta          Decimal   @db.Decimal(10, 2)
}

model OrderPayment {
  tenantId String
  @@index([tenantId])
  id                  String   @id @default(cuid())
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method              String   // CASH, PROMPTPAY_QR, CREDIT_CARD, TRANSFER
  amount              Decimal  @db.Decimal(10, 2)
  cashReceived        Decimal? @db.Decimal(10, 2) // เงินสดที่รับมาจากลูกค้า
  changeGiven         Decimal? @db.Decimal(10, 2) // เงินทอน
  referenceNo         String?
  createdAt           DateTime @default(now())
}

model AuditLog {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorName           String
  action              String   // เช่น "VOID_ORDER", "OPEN_SHIFT", "CHANGE_PRICE"
  details             String
  createdAt           DateTime @default(now())

  @@index([tenantId, createdAt])
}


model CashMovement {
 id String @id @default(cuid())
 tenantId String
 shiftId String
 amount Decimal @db.Decimal(10,2)
 reason String
 createdAt DateTime @default(now())
 @@index([tenantId, shiftId])
}
model PosTerminal {
 id String @id @default(cuid())
 tenantId String
 clientId String
 branchId String
 lastSeenAt DateTime @default(now())
 @@unique([tenantId, clientId])
 @@index([tenantId])
}
model Plan {
 code PlanCode @id
 name String
 price Decimal @db.Decimal(10,2)
 maxBranches Int
 maxTerminals Int
 maxProducts Int
 maxStaff Int
 enableKds Boolean
 enableQrOrder Boolean
 enableRecipeBom Boolean
 enableExport Boolean
}
model Coupon {
 code String @id
 percent Int
 isActive Boolean @default(true)
 expiresAt DateTime?
}
model WebhookEvent {
 id String @id
 type String?
 objectId String?
 status String @default("PROCESSED")
 attempts Int @default(0)
 availableAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)"))
 processedAt DateTime?
 lastError String?
 createdAt DateTime @default(now())
 @@index([status, availableAt])
}
model RateLimit {
 key String @id
 count Int @default(1)
 resetAt DateTime
}
model EmailOutbox {
 pilotEnrollmentId String?
 pilotEnrollment PilotEnrollment? @relation(fields: [pilotEnrollmentId], references: [id], onDelete: Restrict)
 pilotEnrollmentVersion Int?
 pilotTargetEndsAt DateTime?
 notificationKind String?
 id String @id @default(cuid())
 userId String?
 user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
 tenantId String?
 paymentId String? @unique
 dedupeKey String? @unique
 to String
 subject String
 text String
 encryptedText String?
 attempts Int @default(0)
 availableAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)"))
 lockedAt DateTime?
 lockedBy String?
 failedAt DateTime?
 expiresAt DateTime?
 sentAt DateTime?
 lastError String?
 createdAt DateTime @default(now())
 @@index([tenantId])
 @@index([sentAt, failedAt, availableAt])
}

enum AccountTokenKind {
 VERIFY_EMAIL
 PASSWORD_RESET
}
model AccountToken {
 id String @id @default(cuid())
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 kind AccountTokenKind
 tokenHash String @unique
 expiresAt DateTime
 usedAt DateTime?
 createdAt DateTime @default(now())
 @@index([userId, kind])
}
model StaffInvitation {
 id String @id @default(cuid())
 tenantId String
 staffId String
 staff StaffMember @relation(fields: [tenantId, staffId], references: [tenantId, id], onDelete: Cascade)
 email String
 tokenHash String @unique
 invitedBy String
 expiresAt DateTime
 acceptedAt DateTime?
 revokedAt DateTime?
 createdAt DateTime @default(now())
 @@unique([tenantId, email])
 @@index([staffId])
}
model OnboardingDraft {
 userId String @id
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 requestKey String @unique @db.Uuid
 name String @default("")
 businessType BusinessType @default(CAFE_BEVERAGE)
 version Int @default(0)
 completedSlug String?
 updatedAt DateTime @updatedAt
}
model OnboardingRequest {
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 requestKey String @db.Uuid
 requestHash String
 tenantId String @unique
 tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
 createdAt DateTime @default(now())
 @@id([userId, requestKey])
}
